# Copy to .env and fill in. Never commit the real .env file.

PORT=8000

# Comma-separated list of frontend origins allowed to call the API.
# Local dev: http://localhost:5173. Production: your site's URL.
CLIENT_URL=http://localhost:5173

# Set to true when running behind a proxy/load balancer (Render, Railway, Nginx...).
TRUST_PROXY=false

# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers).
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=

# Clerk -> API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google AI Studio -> Get API key. Server-side only.
GEMINI_API_KEY=
# Optional: any Gemini model id. Defaults to the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional AI limits
# Replies per user per day
AI_DAILY_LIMIT=200
# Recent messages sent to Gemini as context
AI_CONTEXT_MESSAGES=20
# Maximum length of one reply, in tokens
AI_MAX_OUTPUT_TOKENS=8192
# Give up when Gemini stalls this long
AI_TIMEOUT_SECONDS=60
MAX_MESSAGES_PER_CHAT=1000

# Optional upload limits (per user)
UPLOADS_PER_HOUR=20
UPLOADS_PER_DAY=100

# ImageKit -> Developer options (images are uploaded through this API)
IMAGE_KIT_ENDPOINT=
IMAGE_KIT_PRIVATE_KEY=
