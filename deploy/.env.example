# Server environment for deploy/docker-compose.yml.
#
# You normally DON'T create this by hand: the GitHub "Deploy" workflow builds it
# from your repository secrets/variables on every deploy. Use it only to run the
# stack manually: copy to .env next to docker-compose.yml, replace every
# <PLACEHOLDER>, then `chmod 600 .env`.

# ---- Image -------------------------------------------------------------------
DOCKERHUB_USERNAME=<YOUR_DOCKERHUB_USERNAME>
IMAGE_NAME=chat-ai
IMAGE_TAG=latest

# ---- Domain (DNS A record must point at this server) -------------------------
DOMAIN=<YOUR_DOMAIN e.g. chat.example.com>
# Defaults to https://$DOMAIN
# CLIENT_URL=https://<YOUR_DOMAIN>

# ---- Database ----------------------------------------------------------------
# Bundled MongoDB container. Use a long random password with only letters and
# digits (it goes into a connection URL), e.g. `openssl rand -hex 24`.
MONGO_ROOT_USERNAME=chatai
MONGO_ROOT_PASSWORD=<STRONG_RANDOM_PASSWORD>
# Optional: use MongoDB Atlas instead of the bundled database.
# MONGODB_URI=mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/chatai

# ---- Clerk (dashboard -> API keys; use the Production instance keys) ---------
CLERK_PUBLISHABLE_KEY=<pk_live_...>
CLERK_SECRET_KEY=<sk_live_...>

# ---- Google Gemini (aistudio.google.com/apikey) ------------------------------
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-flash-latest
AI_DAILY_LIMIT=200

# ---- ImageKit (dashboard -> Developer options) -------------------------------
IMAGE_KIT_ENDPOINT=<https://ik.imagekit.io/YOUR_IMAGEKIT_ID>
IMAGE_KIT_PUBLIC_KEY=<public_...>
IMAGE_KIT_PRIVATE_KEY=<private_...>
