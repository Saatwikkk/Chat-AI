# Copy to .env and fill in. Everything here is bundled into the browser code,
# so only public values belong in this file (never secret keys).

# Clerk -> API keys -> Publishable key
VITE_CLERK_PUBLISHABLE_KEY=

# ImageKit -> Developer options (URL endpoint and *public* key only)
VITE_IMAGE_KIT_ENDPOINT=
VITE_IMAGE_KIT_PUBLIC_KEY=

# Backend URL. Leave empty when the API is on the same origin: local dev (Vite
# proxies /api to http://localhost:8000) or the single-service deploy.
# Set it when the frontend and API are hosted separately, e.g. https://chat-ai-api.onrender.com
VITE_API_URL=
